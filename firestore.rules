rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn()
        && request.auth.token.email == 'medan28082003@gmail.com';
    }

    match /hotels/{hotelId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /applications/{applicationId} {
      allow read, update, delete: if isOwner();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.school is string
        && request.resource.data.school.size() > 0
        && request.resource.data.school.size() <= 150
        && request.resource.data.major is string
        && request.resource.data.major.size() > 0
        && request.resource.data.major.size() <= 100
        && request.resource.data.hotelId is string
        && request.resource.data.hotelName is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500;
    }

    match /announcements/{announcementId} {
      allow read: if isOwner() || resource.data.published == true;
      allow create, update: if isOwner()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.published is bool;
      allow delete: if isOwner();
    }

    match /adminPrivate/{documentId} {
      allow read, write: if isOwner();
    }
  }
}
